# CivicLens Environment Configuration Example
# Copy to .env and replace placeholder values

# PostgreSQL / PostGIS database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civiclens

# JWT Secret for signing session tokens (must be a strong, random key in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# Port for API server (default: 4000)
PORT=4000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Optional comma-separated list of allowed CORS origins
# ALLOWED_ORIGINS=http://localhost:5173,https://civiclens.vercel.app

# Frontend API Base URL (used when building or running the Vite PWA)
# VITE_API_BASE_URL=http://localhost:4000/api
